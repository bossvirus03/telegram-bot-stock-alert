datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model TelegramUser {
  id                 Int      @id @default(autoincrement())
  chatId             String   @unique
  username           String?
  macroAlertLevels   Int[]    @default([1, 0])
  xauAlertEnabled    Boolean  @default(true)
  xauAlertTimeframes String[] @default(["M15", "M30", "H1", "H4", "D1"])
  xauOverboughtRsi   Float    @default(70)
  xauOversoldRsi     Float    @default(30)
  createdAt          DateTime @default(now())

  @@map("telegram_users")
}

model UserWatchlist {
  id        Int      @id @default(autoincrement())
  chatId    String
  username  String?
  symbol    String
  createdAt DateTime @default(now())

  @@unique([chatId, symbol])
  @@map("user_watchlists")
}

model NewsArticle {
  id             Int      @id @default(autoincrement())
  url            String   @unique
  title          String
  summary        String?
  source         String
  symbols        String[]
  publishedAt    DateTime?
  sentToTelegram Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@map("news_articles")
}

model StockAlertLog {
  id        Int      @id @default(autoincrement())
  symbol    String
  alertType String
  message   String
  createdAt DateTime @default(now())

  @@map("stock_alert_logs")
}

model MacroAlertLog {
  id        Int      @id @default(autoincrement())
  eventId   String   @unique
  title     String
  country   String
  eventDate DateTime
  actual    String
  forecast  String?
  previous  String?
  createdAt DateTime @default(now())

  @@map("macro_alert_logs")
}

model XauAlertLog {
  id        Int      @id @default(autoincrement())
  timeframe String
  rsi       Float
  price     Float
  alertType String
  message   String
  createdAt DateTime @default(now())

  @@map("xau_alert_logs")
}

