datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model TelegramUser {
  id                 Int      @id @default(autoincrement())
  chatId             String   @unique
  username           String?
  macroAlertLevels   Int[]    @default([1, 0])
  xauAlertEnabled    Boolean  @default(true)
  xauAlertTimeframes String[] @default(["M15", "M30", "H1", "H4", "D1"])
  xauOverboughtRsi   Float    @default(70)
  xauOversoldRsi     Float    @default(30)
  createdAt          DateTime @default(now())

  @@map("telegram_users")
}

model MacroAlertLog {
  id        Int      @id @default(autoincrement())
  eventId   String   @unique
  title     String
  country   String
  eventDate DateTime
  actual    String
  forecast  String?
  previous  String?
  createdAt DateTime @default(now())

  @@map("macro_alert_logs")
}

model XauAlertLog {
  id        Int      @id @default(autoincrement())
  timeframe String
  rsi       Float
  price     Float
  alertType String
  message   String
  createdAt DateTime @default(now())

  @@map("xau_alert_logs")
}

model PriceAlert {
  id             Int       @id @default(autoincrement())
  chatId         String
  username       String?
  symbol         String    // "XAU", "BTC", "ETH", "SOL", ...
  displaySymbol  String    // "XAU/USD", "BTC/USDT", ...
  assetType      String    // "GOLD", "CRYPTO"
  targetPrice    Float
  initialPrice   Float
  condition      String    // "ABOVE", "BELOW"
  status         String    @default("ACTIVE") // "ACTIVE", "TRIGGERED", "CANCELLED"
  triggeredAt    DateTime?
  triggeredPrice Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([chatId, status])
  @@map("price_alerts")
}

model EmaAlert {
  id              Int       @id @default(autoincrement())
  chatId          String
  username        String?
  symbol          String    // "XAU", "BTC", "ETH", "SOL", ...
  displaySymbol   String    // "XAU/USD", "BTC/USDT", ...
  assetType       String    // "GOLD", "CRYPTO"
  timeframe       String    // "M1", "M5", "M15", "M30", "H1", "H4", "D1"
  fastPeriod      Int       @default(9)
  slowPeriod      Int       @default(21)
  lastCrossType   String?   // "BULLISH", "BEARISH", "NONE"
  lastCrossPrice  Float?
  lastTriggeredAt DateTime?
  status          String    @default("ACTIVE") // "ACTIVE", "PAUSED", "CANCELLED"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([chatId, status])
  @@map("ema_alerts")
}

model EmaAlertLog {
  id         Int      @id @default(autoincrement())
  symbol     String
  timeframe  String
  crossType  String   // "BULLISH", "BEARISH"
  fastPeriod Int
  slowPeriod Int
  fastValue  Float
  slowValue  Float
  price      Float
  message    String
  createdAt  DateTime @default(now())

  @@map("ema_alert_logs")
}



